---
const { kind } = Astro.props as { kind: 'semiconductors' | 'quantum-materials' };
---
<svg class="industry-art" viewBox="0 0 560 290" fill="none" aria-hidden="true">
  <defs><pattern id={`grid-${kind}`} width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0v28" stroke="#b9e6cf" stroke-opacity=".07"/></pattern><clipPath id="wafer-clip"><ellipse cx="295" cy="149" rx="156" ry="100"/></clipPath></defs>
  <rect width="560" height="290" fill={`url(#grid-${kind})`}/>
  {kind === 'semiconductors' ? <g stroke="#b9e6cf">
    <ellipse cx="295" cy="177" rx="156" ry="100" opacity=".12"/>
    <ellipse cx="295" cy="163" rx="156" ry="100" opacity=".2"/>
    <ellipse cx="295" cy="149" rx="156" ry="100" fill="#244c4f"/>
    <g clip-path="url(#wafer-clip)" opacity=".4">{Array.from({ length: 13 },(_,i) => <path d={`M${135+i*27} 44v213M128 ${44+i*21}h335`}/>)}</g>
    <path d="M295 33v232M112 149h366" opacity=".3" stroke-dasharray="3 7"/>
    <path d="m273 127 33-9 20 25-33 9Z" fill="#b9e6cf" fill-opacity=".8"/>
    <path d="M326 143h154v-62M139 149H72v73" opacity=".5"/>
    <circle cx="326" cy="143" r="4" fill="#b9e6cf"/>
    <circle cx="139" cy="149" r="4" fill="#b9e6cf"/>
  </g> : <g stroke="#b9e6cf">
    <path d="m111 180 184-106 159 90-184 106Z" fill="#244c4f" fill-opacity=".5" opacity=".2"/>
    <path d="m111 160 184-106 159 90-184 106Z" opacity=".3"/>
    {Array.from({length:5},(_,r) => Array.from({length:6},(_,c) => {
      const x = 128+c*34+r*29, y = 158-c*19+r*17;
      return <g><path d={`M${x} ${y}l34-19m-34 19 29 17`} opacity=".28"/><circle cx={x} cy={y} r={r===2&&c===3 ? 7 : 4} fill={r===2&&c===3 ? '#cce9a3' : '#8fcbc0'} stroke="none"/></g>;
    }))}
    <circle cx="288" cy="135" r="42" opacity=".3"/>
    <circle cx="288" cy="135" r="62" opacity=".14"/>
    <path d="M288 135v-97h130M128 158H63v66" opacity=".5"/>
  </g>}
  <g stroke="#b9e6cf" opacity=".4"><path d="M33 31h19M42 22v18M508 254h19M518 244v19"/></g>
</svg>
