---
import { content, type Language } from '../data/site';
const { lang } = Astro.props as { lang: Language };
const t = content[lang];
---
<figure class="sample-visual">
  <div class="visual-top"><span class="mono">SAMPLE / ID</span><span class="visual-tag">{t.sample}</span></div>
  <svg class="sample-art" viewBox="0 0 520 410" fill="none" role="img" aria-labelledby="sample-art-title">
    <title id="sample-art-title">{lang === 'zh' ? '原创样品几何示意：一个样品 ID 连接生长、测量与分析记录' : 'Original sample schematic: one sample ID linking growth, measurement, and analysis records'}</title>
    <defs>
      <pattern id="sample-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0v24" stroke="currentColor" stroke-opacity=".07"/></pattern>
      <linearGradient id="sample-fill" x1="150" y1="160" x2="370" y2="270" gradientUnits="userSpaceOnUse"><stop stop-color="#beeccd" stop-opacity=".65"/><stop offset="1" stop-color="#63b8b3" stop-opacity=".16"/></linearGradient>
    </defs>
    <rect width="520" height="410" fill="url(#sample-grid)"/>
    <g stroke="currentColor" stroke-opacity=".19"><path d="M260 44v322M38 205h444" stroke-dasharray="3 8"/><ellipse cx="260" cy="204" rx="180" ry="99"/><ellipse cx="260" cy="204" rx="156" ry="86" stroke-dasharray="3 7"/></g>
    <g stroke="currentColor" stroke-opacity=".22"><path d="m129 138 264 139M127 270l267-139" stroke-dasharray="3 8"/><path d="M44 71h23M55 60v23M453 340h23M465 329v23"/></g>
    <g stroke="var(--visual-stroke)" stroke-width="1.6">
      <path d="m147 183 113-66 113 66v35l-113 66-113-66Z" fill="var(--visual-layer)"/>
      <path d="m147 201 113 66 113-66M147 184l113 66 113-66M260 251v33"/>
      <path d="m165 177 95-55 95 55-95 55Z" fill="url(#sample-fill)"/>
      <path d="m195 160 95 55m-64-73 95 55m-62-74 95 55m-166 17 94-55m-63 74 94-55m-63 74 94-55" stroke-opacity=".45"/>
      <path d="m241 171 20-11 20 11-20 12Z" fill="var(--visual-stroke)"/>
    </g>
    <g stroke="var(--visual-stroke)" stroke-width="1.2"><path d="M165 177H81v-61H50M355 177h84v-70h31M260 284v55h101"/><circle cx="165" cy="177" r="4" fill="var(--visual-stroke)"/><circle cx="355" cy="177" r="4" fill="var(--visual-stroke)"/><circle cx="260" cy="284" r="4" fill="var(--visual-stroke)"/></g>
    <g fill="currentColor" font-family="ui-monospace, monospace" font-size="11"><text x="36" y="105">01 / {lang === 'zh' ? '生长记录' : 'GROWTH'}</text><text x="368" y="95">02 / {lang === 'zh' ? '测量记录' : 'MEASUREMENT'}</text><text x="300" y="361">03 / {lang === 'zh' ? '分析记录' : 'ANALYSIS'}</text><text x="224" y="77" font-size="10" opacity=".7">SAMPLE ID</text></g>
  </svg>
  <figcaption><span class="mono">{t.schematic}</span><span>{t.visualCaption}</span></figcaption>
</figure>
