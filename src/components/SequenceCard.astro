---
import Icon from './Icon.astro';
import { copy } from '../data/copy';
import type { Language } from '../data/site';
import { walCusp } from '../lib/curves';

interface Props { lang: Language; }
const { lang } = Astro.props;
const card = copy[lang].instruments.card;
const curve = walCusp(440, 80);
---
<div class="seq-card">
  <div class="seq-head"><Icon name="magnet" size={18} /><strong>{card.title}</strong><span class="mono">{card.sample}</span></div>
  <ol class="seq-steps">
    {card.steps.map((s, i) => (
      <li class="seq-step" data-state={i < 2 ? 'done' : i === 2 ? 'live' : 'todo'}>
        <span class="dot">{i < 2 ? <Icon name="check" size={13} /> : null}</span>
        <span>{s.label}{i === 2 ? <span class="seq-live mono"> · {card.live}</span> : null}</span>
        <span class="mono">{s.detail}</span>
      </li>
    ))}
  </ol>
  <div class="seq-chart">
    <svg viewBox="0 0 440 96" role="img" aria-label="Rxx(B)">
      <line class="chart-grid" x1="220" y1="0" x2="220" y2="84" />
      <line class="chart-axis" x1="0" y1="84" x2="440" y2="84" />
      <path class="trace-line trace-draw" d={curve.path} pathLength="1" />
      <text class="chart-label" x="0" y="95">−9 T</text>
      <text class="chart-label" x="440" y="95" text-anchor="end">9 T</text>
    </svg>
  </div>
</div>
