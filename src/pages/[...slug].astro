---
import Layout from '../layouts/Layout.astro';
import Home from '../views/Home.astro';
import Products from '../views/Products.astro';
import About from '../views/About.astro';
import { languages, pages, type Language, type Page } from '../data/site';

export function getStaticPaths() {
  return languages.flatMap((lang) => pages.map((page) => ({
    params: { slug: [lang === 'en' ? 'en' : '', page === 'home' ? '' : page].filter(Boolean).join('/') || undefined },
    props: { lang, page },
  })));
}
const { lang, page } = Astro.props as { lang: Language; page: Page };
const View = { home: Home, products: Products, about: About }[page];
---
<Layout lang={lang} page={page}><View lang={lang} /></Layout>
