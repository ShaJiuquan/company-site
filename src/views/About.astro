---
import { company, content, type Language } from '../data/site';
import SampleVisual from '../components/SampleVisual.astro';
const { lang } = Astro.props as { lang: Language };
const p = content[lang].aboutPage;
---
<section class="page-intro container"><p class="eyebrow">{p.eyebrow}</p><h1 class="preserve-lines">{p.title}</h1><p class="intro-description">{p.intro}</p></section>
<section class="about-team container"><div><p class="eyebrow">01 / TEAM</p><h2>{p.teamTitle}</h2><p class="team-placeholder">{company.team}</p>{company.team.startsWith('{{') && <p class="muted">{p.teamNote}</p>}</div><SampleVisual lang={lang}/></section>
<section class="about-grid container"><article><p class="eyebrow">02 / FOCUS</p><h2>{p.scopeTitle}</h2><p>{p.scopeText}</p></article><article><p class="eyebrow">03 / DIRECTION</p><h2>{p.approachTitle}</h2><p>{p.approachText}</p></article></section>
<section class="about-values container"><h2>{p.valuesTitle}</h2><ul>{p.values.map((value, i) => <li><span class="mono">0{i+1}</span>{value}</li>)}</ul></section>
