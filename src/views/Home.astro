---
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import AppShot from '../components/AppShot.astro';
import Hardware from '../components/Hardware.astro';
import Lifecycle from '../components/Lifecycle.astro';
import SampleRecord from '../components/SampleRecord.astro';
import Showcase from '../components/Showcase.astro';
import ppms from '../assets/product/ppms-sequence.webp';
import { copy } from '../data/copy';
import { href, mailto, type Language } from '../data/site';

interface Props { lang: Language; }
const { lang } = Astro.props;
const t = copy[lang];
const scatter = [
  { x: '0%', y: '12%', r: '-4deg' },
  { x: '19%', y: '58%', r: '3deg' },
  { x: '37%', y: '4%', r: '-2deg' },
  { x: '52%', y: '50%', r: '4deg' },
  { x: '69%', y: '10%', r: '2.5deg' },
  { x: '76%', y: '62%', r: '-3.5deg' },
];
---
<section class="stage hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{t.hero.eyebrow}</span>
      <h1 class="display hero-title"><span>{t.hero.title[0]}</span><span class="accent">{t.hero.title[1]}</span></h1>
      <p class="lede">{t.hero.lede}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={mailto}>{t.hero.primary}<Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href={href(lang, 'products')}>{t.hero.secondary}</a>
      </div>
    </div>
    <SampleRecord lang={lang} />
  </div>
</section>

<section class="section" aria-labelledby="problem-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t.problem.eyebrow}</span>
      <h2 class="h2" id="problem-title"><span>{t.problem.title[0]}</span><span>{t.problem.title[1]}</span></h2>
      <p class="problem-caption">{t.problem.caption}</p>
    </div>
    <div class="scatter" aria-hidden="true">
      {t.problem.files.map((f, i) => (
        <div class="file-card reveal" style={`--x:${scatter[i].x};--y:${scatter[i].y};--r:${scatter[i].r};--delay:${i * 0.07}s`}>
          <div class="file-bar"><i /><i /><i /><span>{f.where}</span></div>
          <div class="file-body"><Icon name={f.icon} size={18} /><span class="file-name">{f.file}</span></div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section tint" aria-labelledby="thread-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t.thread.eyebrow}</span>
      <h2 class="h2" id="thread-title"><span>{t.thread.title[0]}</span><span>{t.thread.title[1]}</span></h2>
      <p class="lede">{t.thread.lede}</p>
    </div>
    <div class="thread-wrap reveal">
      <div class="thread">
        <div class="thread-sample"><span class="mono">{t.record.id}</span><small>{t.record.material}</small></div>
        {t.thread.nodes.map((n, i) => (
          <div class:list={['thread-node', { 'thread-node--hl': i >= 3 }]}>
            <span class="thread-date">{n.date}</span>
            <div class="thread-card"><strong>{n.label}</strong><span class="mono">{n.file}</span></div>
          </div>
        ))}
      </div>
      <p class="lineage"><Icon name="branch" size={16} />{t.thread.lineage}</p>
    </div>
    <div class="pillars">
      {t.thread.pillars.map((p, i) => (
        <article class="pillar reveal" style={`--delay:${i * 0.08}s`}>
          <span class="icon-wrap"><Icon name={p.icon} size={22} /></span>
          <h3 class="h3">{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<Lifecycle lang={lang} />

<section class="section stage showcase" aria-labelledby="product-title">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">{t.product.eyebrow}</span>
      <h2 class="h2" id="product-title">{t.product.title}</h2>
      <p class="lede">{t.product.lede}</p>
    </div>
    <div class="reveal">
      <Showcase lang={lang} />
    </div>
    <div class="showcase-meta" style="margin-top: 14px">
      <span class="status-pill">{t.product.status}</span>
      <span class="mono">{t.product.disclaimer}</span>
      <a class="link-arrow" href={href(lang, 'products')}>{t.product.more}<Icon name="arrow" size={16} /></a>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="instruments-title">
  <div class="container split">
    <div class="split-copy reveal">
      <span class="eyebrow">{t.instruments.eyebrow}</span>
      <h2 class="h2" id="instruments-title"><span>{t.instruments.title[0]}</span><span>{t.instruments.title[1]}</span></h2>
      <p class="lede">{t.instruments.text}</p>
      <div class="tags">{t.instruments.tags.map((tag) => <span class="tag" data-state={tag.state}>{tag.label}</span>)}</div>
    </div>
    <figure class="reveal" style="--delay:0.1s">
      <AppShot src={ppms} title="PPMS — Sequence · KT-0912-A2" alt={t.productsPage.instruments.shot} sizes="(max-width: 900px) 92vw, 560px" />
      <figcaption class="concept shot-caption">{t.productsPage.instruments.shot}</figcaption>
    </figure>
  </div>
</section>

<Hardware lang={lang} />

<section class="section" aria-labelledby="audience-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{t.audience.eyebrow}</span>
      <h2 class="h2" id="audience-title">{t.audience.title}</h2>
    </div>
    <div class="cards-3">
      {t.audience.items.map((item, i) => (
        <article class="card reveal" style={`--delay:${i * 0.08}s`}>
          <span class="icon-wrap"><Icon name={item.icon} size={22} /></span>
          <h3 class="h3">{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section stage stage-1" aria-labelledby="ai-title">
  <div class="container split">
    <div class="split-copy reveal">
      <span class="eyebrow">{t.ai.eyebrow}</span>
      <h2 class="h2" id="ai-title"><span>{t.ai.title[0]}</span><span>{t.ai.title[1]}</span></h2>
      <p class="lede">{t.ai.text}</p>
    </div>
    <div class="reveal" style="--delay:0.1s">
      <div class="chat" role="img" aria-label={t.ai.caption}>
        <div class="chat-msg chat-msg--user">{t.ai.chat.user}</div>
        <div class="chat-msg chat-msg--ai">
          <span class="chat-who"><Icon name="spark" size={14} />Agent · MCP</span>
          <span>{t.ai.chat.found}</span>
          <div class="chat-runs">{t.ai.chat.runs.map((r) => <span><Icon name="file" size={14} />{r}</span>)}</div>
          <span>{t.ai.chat.plan}</span>
          <div class="chat-actions">
            <span class="approve"><Icon name="check" size={15} />{t.ai.chat.approve}</span>
            <span class="chat-note"><Icon name="branch" size={14} />{t.ai.chat.note}</span>
          </div>
        </div>
      </div>
      <p class="concept" style="margin-top: 12px">{t.ai.caption}</p>
    </div>
  </div>
</section>

<section class="section tint" aria-labelledby="story-title">
  <div class="container story reveal">
    <span class="eyebrow">{t.story.eyebrow}</span>
    <h2 class="h2" id="story-title"><span>{t.story.title[0]}</span><span>{t.story.title[1]}</span></h2>
    <p>{t.story.text}</p>
    <a class="link-arrow" href={href(lang, 'about')}>{t.story.link}<Icon name="arrow" size={16} /></a>
  </div>
</section>

<Cta lang={lang} />
