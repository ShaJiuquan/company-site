---
import { content, type Language } from '../data/site';
import StatusBadge from '../components/StatusBadge.astro';
import Icon from '../components/Icon.astro';
const { lang } = Astro.props as { lang: Language };
const t = content[lang];
const p = t.productPage;
---
<section class="page-intro container"><p class="eyebrow">{p.eyebrow}</p><h1 class="preserve-lines">{p.title}</h1><p class="intro-description">{p.intro}</p></section>
<div class="container product-index">{t.products.map(product => <a href={`#${product.id}`}><span class="mono">{product.number}</span>{product.name}<Icon name="arrow" /></a>)}</div>
<div class="container product-details">
  <p class="status-legend">{p.legend}</p>
  {t.products.map((product, i) => <article class="product-detail" id={product.id}>
    <header class="product-detail-header"><span class="product-icon"><Icon name={(['sample','instrument','agent'] as const)[i]} /></span><p class="eyebrow">{product.number} / {product.label}</p><h2>{product.name}</h2><div class="status-row"><StatusBadge status={product.status} lang={lang}/>{product.phase && <span class="phase">{product.phase}</span>}</div></header>
    <div class="product-detail-body"><div class="detail-sections"><section><h3>{p.problem}</h3><p>{product.problem}</p></section><section><h3>{p.how}</h3><p>{product.how}</p></section><section class="state-callout"><h3>{p.state}</h3><p>{product.state}</p></section></div><section class="detail-features"><h3>{p.features}</h3><ul class="feature-list">{product.features.map(feature => <li><span>{feature.text}</span><StatusBadge status={feature.status} lang={lang}/></li>)}</ul></section></div>
  </article>)}
</div>
