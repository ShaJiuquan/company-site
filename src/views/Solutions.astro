---
import { content, type Language } from '../data/site';
import { marketing } from '../data/marketing';
import DigitalThread from '../components/DigitalThread.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Icon from '../components/Icon.astro';
const { lang } = Astro.props as { lang: Language };
const m = marketing[lang];
const p = m.solutionsPage;
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const productsHref = `${base}/${lang==='en'?'en/':''}products/`;
---
<section class="page-intro container"><p class="eyebrow">{p.eyebrow}</p><h1 class="preserve-lines">{p.title}</h1><p class="intro-description">{p.intro}</p></section>
<section class="solution-overview container"><div class="section-heading split-heading"><h2>{p.challenge}</h2><p class="section-description">{p.challengeText}</p></div><DigitalThread lang={lang}/></section>
<section class="section container"><p class="eyebrow">SAMPLE / INSTRUMENT / AI</p><h2 class="subpage-section-title">{p.pathwayTitle}</h2><p class="section-description">{p.pathwayNote}</p><div class="solution-pillars">{m.solutionPillars.map((pillar,i) => <article><span class="mono pillar-number">0{i+1}</span><p class="eyebrow">{pillar.subtitle}</p><h3>{pillar.title}</h3><p>{pillar.text}</p><div class="status-row"><StatusBadge status={pillar.status} lang={lang}/><span class="phase">{pillar.scope}</span></div></article>)}</div><a class="text-link" href={productsHref}>{content[lang].details}<Icon name="arrow"/></a></section>
<section class="local-first container"><div><p class="eyebrow">LOCAL FIRST / HUMAN APPROVAL</p><h2>{p.localTitle}</h2></div><div><p>{p.localText}</p><ul class="feature-list">{p.localFeatures.map(feature => <li><span>{feature.text}</span><StatusBadge status={feature.status} lang={lang}/></li>)}</ul></div></section>
